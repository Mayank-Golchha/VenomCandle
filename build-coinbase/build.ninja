build coinbase_market_data.pb.h coinbase_market_data.pb.cc | ${cmake_ninja_workdir}coinbase_market_data.pb.h ${cmake_ninja_workdir}coinbase_market_data.pb.cc: CUSTOM_COMMAND E$:/TradingEngineVela/proto/broker_schemas/coinbase/coinbase_market_data.proto C$:/msys64/ucrt64/bin/protoc.exe
  COMMAND = C:\windows\system32\cmd.exe /C "cd /D E:\TradingEngineVela\build-coinbase && C:\msys64\ucrt64\bin\protoc.exe --cpp_out :E:/TradingEngineVela/build-coinbase -I E:/TradingEngineVela/proto/broker_schemas/coinbase E:/TradingEngineVela/proto/broker_schemas/coinbase/coinbase_market_data.proto"
  DESC = Running cpp protocol buffer compiler on proto/broker_schemas/coinbase/coinbase_market_data.proto
  restat = 1

